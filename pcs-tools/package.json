{
  "name": "pcs-tools",
  "version": "1.0.0",
  "description": "PCS Tools - Playwright/Selenium locator picker, action recorder, test code generator",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "webpack --config webpack.config.js",
    "watch:renderer": "webpack --config webpack.config.js --watch",
    "dev": "concurrently \"npm run watch:renderer\" \"wait-on dist/renderer.js && electron .\"",
    "dist": "npm run build && electron-builder"
  },
  "keywords": [
    "electron",
    "playwright",
    "selenium",
    "locator",
    "test-automation"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "concurrently": "^8.2.2",
    "css-loader": "^6.8.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "html-webpack-plugin": "^5.6.7",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "build": {
    "appId": "com.pcs-tools.app",
    "productName": "PCS Tools",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload-content.js",
      "preload-renderer.js",
      "content-script.js",
      "dist/**/*",
      "src/renderer/index.html",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "PCS-Tools-Portable.exe"
    },
    "asar": true
  }
}
